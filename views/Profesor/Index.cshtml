@model SoporteColegio.ViewModels.ProfesorTicketViewModel
@{
    ViewData["Title"] = "Nuevo aviso";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Soporte Colegio</title>
    <style>
        :root {
            --ink: #17242b;
            --muted: #6c7b80;
            --paper: #f5f1e8;
            --panel: #fffdf7;
            --line: #d8ded8;
            --teal: #087f78;
            --teal-dark: #075e5a;
            --coral: #e8775d;
            --shadow: 0 16px 40px rgba(29, 55, 56, .12);
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            color: var(--ink);
            background: var(--paper);
            font-family: Georgia, 'Times New Roman', serif;
        }
        main { width: min(100% - 32px, 760px); margin: 0 auto; padding: 24px 0 48px; }
        .topline { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 42px; }
        .brand { font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
        .tag { color: var(--teal); font: 700 12px/1.2 Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
        h1 { max-width: 560px; margin: 0; font-size: clamp(38px, 10vw, 72px); line-height: .96; letter-spacing: -.03em; font-weight: 500; }
        .intro { max-width: 490px; margin: 20px 0 34px; color: var(--muted); font: 16px/1.55 Arial, sans-serif; }
        .form-panel { padding: 26px; background: var(--panel); border: 1px solid var(--line); box-shadow: var(--shadow); }
        .step { display: grid; grid-template-columns: 34px 1fr; gap: 14px; padding: 0 0 28px; }
        .step + .step { padding-top: 28px; border-top: 1px solid var(--line); }
        .number { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: white; background: var(--teal); font: 700 14px Arial, sans-serif; }
        .field-group { width: 100%; }
        label, legend { display: block; margin-bottom: 10px; font: 700 14px Arial, sans-serif; }
        .required-mark { color: var(--coral); }
        select, textarea { width: 100%; border: 1px solid #bdc9c5; border-radius: 2px; color: var(--ink); background: white; font: 16px/1.4 Arial, sans-serif; }
        select { min-height: 52px; padding: 0 14px; }
        textarea { min-height: 108px; padding: 14px; resize: vertical; }
        select:focus, textarea:focus { outline: 3px solid rgba(8, 127, 120, .2); border-color: var(--teal); }
        .hint { margin: -2px 0 12px; color: var(--muted); font: 13px/1.4 Arial, sans-serif; }
        .field-validation-error, .validation-summary-errors { color: #ad3f2b; font: 13px/1.4 Arial, sans-serif; }
        .validation-summary-errors { margin-bottom: 18px; }
        .actions { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-top: 4px; }
        button { min-height: 52px; padding: 0 22px; border: 0; border-radius: 2px; color: white; background: var(--coral); cursor: pointer; font: 700 15px Arial, sans-serif; }
        button:hover { background: #cf5f49; }
        button:disabled { opacity: .7; cursor: progress; }
        .success { margin: 0 0 22px; padding: 14px 16px; border-left: 4px solid var(--teal); color: var(--teal-dark); background: #e3f1e8; font: 15px/1.45 Arial, sans-serif; }
        .status-box { display: none; margin: 0 0 18px; padding: 14px 16px; border-left: 4px solid var(--coral); color: var(--ink); background: #fff5ea; font: 15px/1.45 Arial, sans-serif; }
        .status-box.visible { display: block; }
        .privacy { margin: 0; color: var(--muted); font: 12px/1.4 Arial, sans-serif; }
        .toast { position: fixed; right: 20px; bottom: 20px; max-width: 320px; padding: 14px 16px; color: white; background: var(--teal-dark); box-shadow: var(--shadow); font: 14px/1.4 Arial, sans-serif; opacity: 0; transform: translateY(12px); transition: opacity .25s ease, transform .25s ease; }
        .toast.visible { opacity: 1; transform: translateY(0); }
        @@media (max-width: 520px) {
            main { width: min(100% - 24px, 760px); padding-top: 16px; }
            .topline { margin-bottom: 34px; }
            .form-panel { padding: 20px 16px; }
            .actions { align-items: stretch; flex-direction: column; }
            button { width: 100%; }
        }
    </style>
</head>
<body>
    <main>
        <div class="topline">
            <span class="brand">Soporte colegio</span>
            <span class="tag">Aviso rápido</span>
        </div>

        <h1>¿Qué ocurre en tu sala?</h1>
        <p class="intro">Cuéntanos dónde estás y qué equipo necesita ayuda. El equipo de soporte recibirá el aviso de inmediato.</p>

        <div id="profesor-notificaciones" class="status-box" aria-live="polite"></div>

        @if (TempData["TicketCreado"] is string message)
        {
            <p class="success" role="status">@message</p>
        }

        <form id="ticket-form" asp-action="Registrar" method="post" class="form-panel" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="step">
                <span class="number">1</span>
                <div class="field-group">
                    <label asp-for="SalaId">¿En qué sala estás? <span class="required-mark">*</span></label>
                    <p class="hint">Selecciona la sala o espacio donde ocurre el problema.</p>
                    <select asp-for="SalaId" required>
                        <option value="">Selecciona una sala</option>
                        @foreach (var sala in Model.Salas)
                        {
                            <option value="@sala.Id">@sala.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="SalaId"></span>
                </div>
            </div>

            <div class="step">
                <span class="number">2</span>
                <div class="field-group">
                    <label asp-for="FallaComunId">¿Qué problema encontraste? <span class="required-mark">*</span></label>
                    <p class="hint">Elige la opción que mejor describe lo que ves.</p>
                    <select asp-for="FallaComunId" required>
                        <option value="">Selecciona un problema</option>
                        @foreach (var falla in Model.FallasComunes)
                        {
                            <option value="@falla.Id">@falla.Equipo: @falla.Descripcion</option>
                        }
                    </select>
                    <span asp-validation-for="FallaComunId"></span>
                </div>
            </div>

            <div class="step">
                <span class="number">3</span>
                <div class="field-group">
                    <label asp-for="DetalleAdicional">¿Quieres agregar algo más?</label>
                    <p class="hint">Opcional. Por ejemplo: número del equipo, mensaje en pantalla o cuándo comenzó.</p>
                    <textarea asp-for="DetalleAdicional" maxlength="500" placeholder="Escribe un detalle breve..."></textarea>
                    <span asp-validation-for="DetalleAdicional"></span>
                </div>
            </div>

            <div class="actions">
                <p class="privacy">Tu aviso quedará registrado como pendiente.</p>
                <button id="submit-button" type="submit">Enviar aviso</button>
            </div>
        </form>
    </main>
    <partial name="_Chatbot" />
    <div id="toast" class="toast" aria-live="polite"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const notificationBox = document.getElementById('profesor-notificaciones');
        const form = document.getElementById('ticket-form');
        const submitButton = document.getElementById('submit-button');
        const toast = document.getElementById('toast');

        function showNotification(message) {
            if (!notificationBox) return;
            notificationBox.textContent = message;
            notificationBox.classList.add('visible');
            setTimeout(() => notificationBox.classList.remove('visible'), 5000);
        }

        function showToast(message) {
            if (!toast) return;
            toast.textContent = message;
            toast.classList.add('visible');
            setTimeout(() => toast.classList.remove('visible'), 4200);
        }

        form?.addEventListener('submit', event => {
            if (!form.checkValidity()) {
                event.preventDefault();
                form.reportValidity();
                return;
            }

            submitButton.disabled = true;
            showToast('Enviando aviso...');
        });

        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/notificaciones-soporte')
            .withAutomaticReconnect()
            .build();

        connection.on('TicketCreado', ticket => {
            showNotification(`Nuevo aviso recibido en ${ticket.sala}. El equipo de soporte ya lo está revisando.`);
        });

        connection.on('TicketEstadoActualizado', notification => {
            if (notification && notification.mensaje) {
                showNotification(notification.mensaje);
            }
        });

        connection.start().catch(error => console.error('SignalR del profesor no disponible:', error));
    </script>
</body>
</html>
